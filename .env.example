APP_NAME=Emberpath Weight Service
APP_VERSION=0.1.0
# For direct local runs; hub Compose reads ../Emberpath/.env, not this file.
# WEIGHT_API_PORT (default 8000) belongs in the hub, not this Settings file.
# API_PORT is a deprecated Compose-only fallback.
# development, test, or production. Production requires explicit ALLOWED_HOSTS.
# ENVIRONMENT=development
# Comma-separated values are accepted by Pydantic Settings.
# ALLOWED_HOSTS=api.example.com
# CORS_ORIGINS=http://localhost:5173
# CORS_METHODS=GET,POST,PATCH,DELETE
# CORS_HEADERS=Authorization,Content-Type,X-Request-ID
# CORS_ALLOW_CREDENTIALS=false
# DOCS_ENABLED=false
# LOG_LEVEL=INFO

# Weight uses its own PostgreSQL database. Set its URL before running locally.
DATABASE_REQUIRED=true
# Use 127.0.0.1 and the published POSTGRES_PORT (default 5432); match the
# running database's user, password, and name. URL-encode credentials.
# DATABASE_URL=<postgresql+psycopg URL for the weight database>
# DATABASE_CONNECT_TIMEOUT_SECONDS=10
# DATABASE_POOL_SIZE=5
# DATABASE_MAX_OVERFLOW=10
# DATABASE_POOL_TIMEOUT_SECONDS=30
# DATABASE_POOL_RECYCLE_SECONDS=1800
# DATABASE_POOL_PRE_PING=true
# DATABASE_STATEMENT_TIMEOUT_SECONDS=30
# DATABASE_LOCK_TIMEOUT_SECONDS=10
# DATABASE_IDLE_TRANSACTION_TIMEOUT_SECONDS=60

# Use the same Clerk development issuer and frontend origins as hub Compose.
# Replace these placeholders for authenticated routes; no Clerk secret key is needed.
# CLERK_ISSUER=<exact Clerk HTTPS issuer origin>
# CLERK_AUTHORIZED_PARTIES=<comma-separated frontend origins (web defaults to port 5173)>
